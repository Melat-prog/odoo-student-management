<odoo>

    <!-- Student List View -->
    <record id="view_student_list" model="ir.ui.view">
        <field name="name">student.list</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="age"/>
                <field name="email"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

   <record id="view_student_form" model="ir.ui.view">
    <field name="name">student.form</field>
    <field name="model">student.student</field>
    <field name="arch" type="xml">
        <form>
    <sheet>
    
       <div class="oe_button_box" name="button_box">

    <!-- Total Attendance -->
    <button name="action_view_attendance"
            type="object"
            class="oe_stat_button"
            icon="fa-calendar">
        <field name="attendance_count" widget="statinfo" string="Attendance"/>
    </button>

    <!-- Present -->
    <button name="action_view_attendance"
            type="object"
            class="oe_stat_button"
            icon="fa-check">
        <field name="present_count" widget="statinfo" string="Present"/>
    </button>

    <!-- Absent -->
    <button name="action_view_attendance"
            type="object"
            class="oe_stat_button"
            icon="fa-times">
        <field name="absent_count" widget="statinfo" string="Absent"/>
    </button>

</div>
        <!-- 🧑 BASIC INFO -->
        <group string="Student Info">
            <group>
                <field name="name"/>
                <field name="age"/>
            </group>
            <group>
                <field name="email"/>
                <field name="phone"/>
            </group>
        </group>

        <!-- 🎓 COURSE -->
        <group string="Course">
            <field name="course_id"/>
        </group>

        <!-- NOTEBOOK-->
        <notebook>

            <!--Attendance Tab -->
            <page string="Attendance">

                <group string="Statistics">
                    <group>
                        <field name="attendance_count" readonly="1"/>
                        <field name="present_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="absent_count" readonly="1"/>
                        <field name="attendance_percentage" widget="progressbar"/>
                    </group>
                </group>

                <field name="attendance_ids">
                    <list editable="bottom">
                        <field name="date"/>
                        <field name="course_id"/>
                        <field name="status"
                               decoration-success="status == 'present'"
                               decoration-danger="status == 'absent'"/>
                    </list>
                </field>

            </page>

            <!--  Notes Tab -->
            <page string="Notes">
                <field name="note"/>
            </page>

        </notebook>
    </sheet>
</form>
    </field>
</record>   
<!-- Student Kanban View -->
<record id="view_student_kanban" model="ir.ui.view">
    <field name="name">student.kanban</field>
    <field name="model">student.student</field>
    <field name="arch" type="xml">

        <!-- KANBAN ROOT -->
        <kanban>

            <!-- Fields used inside kanban -->
            <field name="name"/>
            <field name="course_id"/>
            <field name="attendance_percentage"/>

            <templates>
                <t t-name="kanban-box">

                    <!-- Card container -->
                    <div class="oe_kanban_card p-3">

                        <!-- Student Name -->
                        <strong>
                            <field name="name"/>
                        </strong>

                        <br/>

                        <!-- Course -->
                        <div>
                            Course:
                            <field name="course_id"/>
                        </div>

                        <br/>

                        <!-- Attendance Progress -->
                        <div>
                            Attendance:
                            <field name="attendance_percentage"
                                   widget="progressbar"/>
                        </div>

                    </div>

                </t>
            </templates>

        </kanban>
    </field>
</record>
<!-- Student Search View -->
<record id="view_student_search" model="ir.ui.view">
    <field name="name">student.student.search</field>
    <field name="model">student.student</field>
    <field name="arch" type="xml">
        <search>

    <!-- Search -->
    <field name="name"/>
    <field name="course_id"/>

    <!-- Filters -->
    <separator/>

    <filter name="has_attendance"
            string="Has Attendance"
            domain="[('attendance_ids','!=',False)]"/>

    <filter name="no_attendance"
            string="No Attendance"
            domain="[('attendance_ids','=',False)]"/>

    <!-- Group By -->
    <group expand="0" string="Group By">
        <filter name="group_by_course"
                string="Course"
                context="{'group_by': 'course_id'}"/>
    </group>

           </search>
    </field>
</record>
    <!-- Action -->
    <record id="action_student" model="ir.actions.act_window">
    <field name="name">Students</field>
    <field name="res_model">student.student</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="search_view_id" ref="view_student_search"/>
</record> 
    <!-- Root Menu -->
    <menuitem id="student_menu_root"
              name="Student Management"
              sequence="10"/>

    <!-- Students Menu -->
    <menuitem id="student_menu_students"
              name="Students"
              parent="student_menu_root"
              action="action_student"
              sequence="10"/>

</odoo>