<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_student_card" model="ir.actions.report">
        <field name="name">Student Report Card</field>
        <field name="model">student.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">student_management.report_student_card_template</field>
        <field name="report_file">student_management.report_student_card_template</field>
        <field name="print_report_name">'Report Card - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_student_student"/>
        <field name="binding_type">report</field>
    </record>
    <record id="action_report_enrollment_confirmation" model="ir.actions.report">
        <field name="name">Enrollment Confirmation</field>
        <field name="model">student.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">student_management.report_enrollment_template</field>
        <field name="report_file">student_management.report_enrollment_template</field>
        <field name="print_report_name">'Enrollment_%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_student_student"/>
        <field name="binding_type">report</field>
    </record>
   <record id="action_report_student_transcript" model="ir.actions.report">
        <field name="name">Student Transcript</field>
        <field name="model">student.student</field>
        <field name="report_type">qweb-pdf</field>
        <!-- These two lines MUST match the template ID above -->
        <field name="report_name">student_management.report_student_card_template</field>
        <field name="report_file">student_management.report_student_card_template</field>
        <field name="print_report_name">'Transcript_%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_student_student"/>
        <field name="binding_type">report</field>
    </record>
</odoo>