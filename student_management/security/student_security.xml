<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_student_management" model="ir.module.category">
            <field name="name">Student Management</field>
            <field name="description">Helps manage students, grades, and sessions.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_student" model="res.groups">
            <field name="name">Student</field>
            <field name="category_id" ref="module_category_student_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="group_parent" model="res.groups">
            <field name="name">Parent / Guardian</field>
            <field name="category_id" ref="module_category_student_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="group_teacher" model="res.groups">
            <field name="name">Teacher</field>
            <field name="category_id" ref="module_category_student_management"/>
        </record>

        <record id="group_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_student_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('group_teacher'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
        <record id="group_student_manager" model="res.groups">
            <field name="name">Student Manager</field>
            <field name="category_id" ref="module_category_student_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('group_teacher'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <!-- Teacher Rules -->
        <record id="rule_teacher_admission" model="ir.rule">
            <field name="name">Teacher: Assigned Admissions</field>
            <field name="model_id" ref="model_admission_application"/>
            <field name="groups" eval="[(4, ref('student_management.group_teacher'))]"/>
            <field name="domain_force">['|', ('teacher_id', '=', False), ('teacher_id.user_id', '=', user.id)]</field>
        </record>

        <record id="rule_teacher_assignment" model="ir.rule">
            <field name="name">Teacher: Own Assignments Only</field>
            <field name="model_id" ref="model_teacher_assignment"/>
            <field name="groups" eval="[(4, ref('student_management.group_teacher'))]"/>
            <field name="domain_force">[('teacher_id.user_id', '=', user.id)]</field>
        </record>
        
        <record id="rule_teacher_submission" model="ir.rule">
            <field name="name">Teacher: Submissions for Own Assignments</field>
            <field name="model_id" ref="model_student_submission"/>
            <field name="groups" eval="[(4, ref('student_management.group_teacher'))]"/>
            <field name="domain_force">[('assignment_id.teacher_id.user_id', '=', user.id)]</field>
        </record>

        <!-- Student Rules -->
        <record id="rule_student_own_profile" model="ir.rule">
            <field name="name">Student: Own Profile</field>
            <field name="model_id" ref="model_student_student"/>
            <field name="groups" eval="[(4, ref('student_management.group_student'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>

        <record id="rule_student_course" model="ir.rule">
            <field name="name">Student: Enrolled Courses</field>
            <field name="model_id" ref="model_student_course"/>
            <field name="groups" eval="[(4, ref('student_management.group_student'))]"/>
            <field name="domain_force">[('student_ids.user_id', '=', user.id)]</field>
        </record>

        <record id="rule_student_submission" model="ir.rule">
            <field name="name">Student: Own Submissions</field>
            <field name="model_id" ref="model_student_submission"/>
            <field name="groups" eval="[(4, ref('student_management.group_student'))]"/>
            <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
        </record>

        <record id="rule_student_grade" model="ir.rule">
            <field name="name">Student: Own Grades</field>
            <field name="model_id" ref="model_student_grade"/>
            <field name="groups" eval="[(4, ref('student_management.group_student'))]"/>
            <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
        </record>
        
        <record id="rule_student_attendance" model="ir.rule">
            <field name="name">Student: Own Attendance</field>
            <field name="model_id" ref="model_student_attendance"/>
            <field name="groups" eval="[(4, ref('student_management.group_student'))]"/>
            <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
        </record>

        <!-- Parent Rules -->
        <record id="rule_parent_linked_children" model="ir.rule">
            <field name="name">Parent: Linked Children Profiles</field>
            <field name="model_id" ref="model_student_student"/>
            <field name="groups" eval="[(4, ref('student_management.group_parent'))]"/>
            <field name="domain_force">[('parent_ids.user_id', '=', user.id)]</field>
        </record>

        <record id="rule_parent_course" model="ir.rule">
            <field name="name">Parent: Linked Children Courses</field>
            <field name="model_id" ref="model_student_course"/>
            <field name="groups" eval="[(4, ref('student_management.group_parent'))]"/>
            <field name="domain_force">[('student_ids.parent_ids.user_id', '=', user.id)]</field>
        </record>

        <record id="rule_parent_grade" model="ir.rule">
            <field name="name">Parent: Linked Children Grades</field>
            <field name="model_id" ref="model_student_grade"/>
            <field name="groups" eval="[(4, ref('student_management.group_parent'))]"/>
            <field name="domain_force">[('student_id.parent_ids.user_id', '=', user.id)]</field>
        </record>
        
        <record id="rule_parent_attendance" model="ir.rule">
            <field name="name">Parent: Linked Children Attendance</field>
            <field name="model_id" ref="model_student_attendance"/>
            <field name="groups" eval="[(4, ref('student_management.group_parent'))]"/>
            <field name="domain_force">[('student_id.parent_ids.user_id', '=', user.id)]</field>
        </record>

        <!-- Portal Record Rules (allow read for all portal users) -->
        <record id="rule_portal_assignment" model="ir.rule">
            <field name="name">Portal: Read All Assignments</field>
            <field name="model_id" ref="model_teacher_assignment"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_portal_resource" model="ir.rule">
            <field name="name">Portal: Read All Learning Resources</field>
            <field name="model_id" ref="model_student_learning_resource"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_portal_course" model="ir.rule">
            <field name="name">Portal: Read All Courses</field>
            <field name="model_id" ref="model_student_course"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_portal_class" model="ir.rule">
            <field name="name">Portal: Read All Classes</field>
            <field name="model_id" ref="model_student_class"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_portal_subject" model="ir.rule">
            <field name="name">Portal: Read All Subjects</field>
            <field name="model_id" ref="model_student_subject"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>