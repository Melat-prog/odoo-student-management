<odoo>
    <record id="view_student_class_form" model="ir.ui.view">
        <field name="name">student.class.form</field>
        <field name="model">student.class</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Class Name"/>
                        <h1><field name="name" placeholder="e.g. Grade 10-A"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="capacity"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Weekly Schedule" name="schedule" icon="fa-calendar">
                            <field name="schedule_ids">
                                <list editable="bottom">
                                    <field name="day"/>
                                    <field name="subject_id"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="end_time" widget="float_time"/>
                                </list>
                            </field>
                        </page>
                        <page string="Students" name="students">
                            <field name="student_ids" readonly="1">
                                <list>
                                    <field name="student_id"/>
                                    <field name="name"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Subjects" name="subjects">
                            <field name="subject_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_student_class" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">student.class</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_student_class" 
              name="Classes" 
              parent="menu_academic_root" 
              action="action_student_class" 
              sequence="10"/>
</odoo>