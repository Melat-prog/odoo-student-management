<odoo>
    <record id="view_timetable_form" model="ir.ui.view">
        <field name="name">student.timetable.form</field>
        <field name="model">student.class</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" string="Course / Class" placeholder="e.g. BCA"/>
                            <field name="academic_year" placeholder="e.g. 2025-2026"/>
                            <field name="code" string="Academic Term" placeholder="e.g. Term 1"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Monday" name="monday">
                            <field name="schedule_ids" context="{'default_day': 'monday'}" domain="[('day', '=', 'monday')]">
                                <list editable="bottom">
                                    <field name="classroom"/>
                                    <field name="subject_id" string="Subject"/>
                                    <field name="teacher_id" string="Faculty"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="end_time" widget="float_time"/>
                                    <field name="day" column_invisible="True"/>
                                </list>
                            </field>
                        </page>

                        <page string="Tuesday" name="tuesday">
                            <field name="schedule_ids" context="{'default_day': 'tuesday'}" domain="[('day', '=', 'tuesday')]">
                                <list editable="bottom">
                                    <field name="classroom"/>
                                    <field name="subject_id"/>
                                    <field name="teacher_id"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="end_time" widget="float_time"/>
                                    <field name="day" column_invisible="True"/>
                                </list>
                            </field>
                        </page>

                        <page string="Wednesday" name="wednesday">
                            <field name="schedule_ids" context="{'default_day': 'wednesday'}" domain="[('day', '=', 'wednesday')]">
                                <list editable="bottom">
                                    <field name="classroom"/>
                                    <field name="subject_id"/>
                                    <field name="teacher_id"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="end_time" widget="float_time"/>
                                    <field name="day" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_timetable" model="ir.actions.act_window">
        <field name="name">Timetable</field>
        <field name="res_model">student.class</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_timetable_sub"
              name="Timetable"
              parent="student_management.menu_student_root"
              action="action_timetable"
              sequence="30"/>
</odoo>