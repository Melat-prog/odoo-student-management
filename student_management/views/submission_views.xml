<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_student_submission_tree" model="ir.ui.view">
        <field name="name">student.submission.tree</field>
        <field name="model">student.submission</field>
        <field name="arch" type="xml">
            <list string="Submissions">
                <field name="student_id"/>
                <field name="assignment_id"/>
                <field name="submission_date"/>
                <field name="grade"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_student_submission_form" model="ir.ui.view">
        <field name="name">student.submission.form</field>
        <field name="model">student.submission</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" 
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_grade" type="object" string="Mark as Graded" 
                            class="btn-success" invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,graded"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id" readonly="state == 'graded'"/>
                            <field name="assignment_id" readonly="state == 'graded'"/>
                            <field name="submission_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="submission_file" filename="file_name" readonly="state == 'graded'"/>
                            <field name="file_name" invisible="1"/>
                            <field name="grade" invisible="state == 'draft'" required="state == 'submitted'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Student Notes">
                            <field name="notes" placeholder="Student comments..."/>
                        </page>
                        <page string="Teacher Feedback" invisible="state == 'draft'">
                            <field name="teacher_feedback" placeholder="Add feedback here..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_student_submission_graph" model="ir.ui.view">
        <field name="name">student.submission.graph</field>
        <field name="model">student.submission</field>
        <field name="arch" type="xml">
            <graph string="Submissions Analysis" type="bar">
                <field name="assignment_id"/>
                <field name="grade"/>
            </graph>
        </field>
    </record>

    <record id="view_student_submission_pivot" model="ir.ui.view">
        <field name="name">student.submission.pivot</field>
        <field name="model">student.submission</field>
        <field name="arch" type="xml">
            <pivot string="Submissions Analysis">
                <field name="assignment_id" type="row"/>
                <field name="grade" type="col"/>
            </pivot>
        </field>
    </record>
    <record id="action_student_submission" model="ir.actions.act_window">
        <field name="name">Submissions</field>
        <field name="res_model">student.submission</field>
        <field name="view_mode">list,form,graph,pivot</field>
    </record>

    <menuitem id="menu_student_submission" name="Submissions" parent="student_management.menu_teacher_work_root" action="action_student_submission" sequence="30"/>
</odoo>
