<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assignment_form" model="ir.ui.view">
        <field name="name">teacher.assignment.form</field>
        <field name="model">teacher.assignment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" invisible="state != 'new'" class="btn-primary"/>
                    <button name="action_complete" type="object" string="Complete" invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,in_progress,completed"/>
                </header>
                <sheet>
                <div class="oe_button_box" name="button_box">
    <button name="action_view_submissions" 
            type="object" 
            class="oe_stat_button" 
            icon="fa-file-text-o">
        <field name="submission_count" widget="statinfo" string="Submissions"/>
    </button>
</div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Mid-Term Project"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="teacher_id"/>
                            <field name="subject_id"/>
                        </group>
                        <group>
                            <field name="class_id"/>
                            <field name="issue_date"/>
                            <field name="due_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Instructions">
                            <field name="description" placeholder="Describe the assignment details..."/>
                        </page>
                        <page string="Resources">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_assignment_list" model="ir.ui.view">
        <field name="name">teacher.assignment.list</field>
        <field name="model">teacher.assignment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="teacher_id"/>
                <field name="subject_id"/>
                <field name="class_id"/>
                <field name="due_date"/>
                <field name="state" widget="badge" decoration-info="state == 'new'" decoration-warning="state == 'in_progress'" decoration-success="state == 'completed'"/>
            </list>
        </field>
    </record>

    <record id="action_assignment" model="ir.actions.act_window">
        <field name="name">Assignments</field>
        <field name="res_model">teacher.assignment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_assignment" name="Tasks &amp; Assignments" parent="student_management.menu_teacher_work_root" action="action_assignment" sequence="20"/>
</odoo>