<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_exam_session_form" model="ir.ui.view">
        <field name="name">student.exam.session.form</field>
        <field name="model">student.exam.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_schedule" type="object" string="Schedule" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Start Exam" class="btn-primary" invisible="state != 'scheduled'"/>
                    <button name="action_complete" type="object" string="Mark Completed" class="btn-primary" invisible="state != 'ongoing'"/>
                    <button name="action_fetch_students" type="object" string="Fetch Students" icon="fa-users" invisible="state not in ('draft', 'scheduled')"/>
                    <button name="action_post" type="object" string="Submit Grades" class="btn-success" icon="fa-check" invisible="state != 'completed'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" class="btn-secondary" icon="fa-undo" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,ongoing,completed,graded"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. 2026 Midterm Biology"/></h1>
                    </div>
                    <group>
                        <group string="Exam Details">
                            <field name="subject_id"/>
                            <field name="class_id"/>
                            <field name="course_id" optional="hide"/>
                            <field name="exam_type" widget="radio" options="{'horizontal': true}"/>
                        </group>
                        <group string="Configuration">
                            <field name="date"/>
                            <field name="max_score"/>
                            <field name="pass_mark"/>
                            <field name="teacher_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Student Results">
                            <field name="exam_line_ids">
                                <list editable="bottom" decoration-danger="result_status == 'fail'" decoration-success="result_status == 'pass'">
                                    <field name="student_id"/>
                                    <field name="marks"/>
                                    <field name="percentage" widget="progressbar"/>
                                    <field name="grade" widget="badge"/>
                                    <field name="result_status" widget="badge" decoration-success="result_status == 'pass'" decoration-danger="result_status == 'fail'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_exam_session_list" model="ir.ui.view">
        <field name="name">student.exam.session.list</field>
        <field name="model">student.exam.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="course_id"/>
                <field name="exam_type"/>
                <field name="date"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'graded'"/>
            </list>
        </field>
    </record>

    <record id="view_student_exam_list" model="ir.ui.view">
        <field name="name">student.exam.list</field>
        <field name="model">student.exam</field>
        <field name="arch" type="xml">
            <list decoration-danger="result_status == 'fail'" decoration-success="result_status == 'pass'">
                <field name="student_id"/>
                <field name="name"/>
                <field name="exam_type"/>
                <field name="marks"/>
                <field name="percentage" widget="progressbar"/>
                <field name="grade" decoration-bf="1"/> 
                <field name="result_status" widget="badge" decoration-success="result_status == 'pass'" decoration-danger="result_status == 'fail'"/>
            </list>
        </field>
    </record>

    <record id="view_student_exam_form" model="ir.ui.view">
        <field name="name">student.exam.form</field>
        <field name="model">student.exam</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Exam Subject/Title"/>
                        <h1><field name="name" placeholder="e.g. Mid Semester Math"/></h1>
                    </div>
                    <group>
                        <group string="Exam Details">
                            <field name="student_id"/>
                            <field name="session_id"/> 
                            <field name="exam_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="date"/>
                        </group>
                        <group string="Results">
                            <field name="max_marks"/>
                            <field name="marks"/>
                            <field name="percentage" widget="progressbar"/>
                            <field name="grade" readonly="1"/>
                            <field name="result_status" widget="badge" decoration-success="result_status == 'pass'" decoration-danger="result_status == 'fail'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_exam_session" model="ir.actions.act_window">
        <field name="name">Exam Sessions</field>
        <field name="res_model">student.exam.session</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_exam_mid" model="ir.actions.act_window">
        <field name="name">Mid Exams</field>
        <field name="res_model">student.exam</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('exam_type', 'in', ['quiz', 'midterm'])]</field>
        <field name="context">{'default_exam_type': 'midterm'}</field>
    </record>

    <record id="action_exam_final" model="ir.actions.act_window">
        <field name="name">Final Exams</field>
        <field name="res_model">student.exam</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('exam_type', '=', 'final')]</field>
        <field name="context">{'default_exam_type': 'final'}</field>
    </record>

    <record id="action_exam_exit" model="ir.actions.act_window">
        <field name="name">Exit Exams</field>
        <field name="res_model">student.exam</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('exam_type', '=', 'exit')]</field>
        <field name="context">{'default_exam_type': 'exit'}</field>
    </record>

    <!-- Academic Exams Menu -->
    <menuitem id="menu_exam_root" name="Examinations" parent="student_menu_root" sequence="50"/>
    <menuitem id="menu_exam_session" name="Exam Sessions" parent="menu_exam_root" action="action_exam_session" sequence="10"/>
    <menuitem id="menu_exam_mid" name="Mid Exams / Quizzes" parent="menu_exam_root" action="action_exam_mid" sequence="20"/>
    <menuitem id="menu_exam_final" name="Final Exams" parent="menu_exam_root" action="action_exam_final" sequence="30"/>
    <menuitem id="menu_exam_exit" name="Exit Exams" parent="menu_exam_root" action="action_exam_exit" sequence="40"/>
</odoo>
