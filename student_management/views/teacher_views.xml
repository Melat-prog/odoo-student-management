<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_student_teacher_list" model="ir.ui.view">
        <field name="name">student.teacher.list</field>
        <field name="model">student.teacher</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="specialization"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_student_teacher_kanban" model="ir.ui.view">
        <field name="name">student.teacher.kanban</field>
        <field name="model">student.teacher</field>
        <field name="arch" type="xml">
            <kanban class="o_res_partner_kanban">
                <field name="id"/>
                <field name="image_1920"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click d-flex align-items-center">
                            <div class="o_kanban_image me-3">
                                <field name="image_1920" widget="image" class="o_kanban_image"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div class="text-muted"><field name="specialization"/></div>
                                <div class="mt-1"><i class="fa fa-envelope me-1" title="Email"/> <field name="email"/></div>
                                <div><i class="fa fa-phone me-1" title="Phone"/> <field name="phone"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_student_teacher_form" model="ir.ui.view">
        <field name="name">student.teacher.form</field>
        <field name="model">student.teacher</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_user" type="object" string="Create Portal Account" invisible="user_id != False" groups="student_management.group_student_manager"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_1920', 'size': [90, 90]}"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Teacher Name" default_focus="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Personal Information">
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="id_number"/>
                            <field name="bank_account"/>
                        </group>
                        <group string="Academic Details">
                            <field name="specialization"/>
                            <field name="user_id" placeholder="Select login user..."/>
                            <field name="emergency_contact"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Subject Allocations" name="allocations">
                            <field name="allocation_ids" nolabel="1">
                                <list>
                                    <field name="subject_id"/>
                                    <field name="class_id"/>
                                    <field name="semester"/>
                                </list>
                            </field>
                        </page>
                        <page string="Timetable" name="timetable">
                            <field name="schedule_ids" nolabel="1">
                                <list>
                                    <field name="day"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="end_time" widget="float_time"/>
                                    <field name="class_id"/>
                                    <field name="subject_id"/>
                                    <field name="classroom"/>
                                </list>
                            </field>
                        </page>
                        <page string="Resume &amp; Address" name="resume">
                            <group>
                                <group>
                                    <field name="resume_file" filename="resume_filename"/>
                                    <field name="resume_filename" invisible="1"/>
                                </group>
                                <group>
                                    <field name="address" widget="text"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_student_teacher" model="ir.actions.act_window">
        <field name="name">Teacher's Profiles</field>
        <field name="res_model">student.teacher</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="menu_teacher_work_root" name="Teachers" parent="student_menu_root" sequence="30"/>
    <menuitem id="menu_student_teacher_sub" name="Teacher Profiles" parent="menu_teacher_work_root" action="action_student_teacher" sequence="10"/>

</odoo>