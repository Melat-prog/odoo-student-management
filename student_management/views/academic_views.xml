<odoo>

    <!-- Class List -->
    <record id="view_class_list" model="ir.ui.view">
        <field name="name">student.class.list</field>
        <field name="model">student.class</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="capacity"/>
            </list>
        </field>
    </record>

    <!-- Class Form -->
    <record id="view_class_form" model="ir.ui.view">
        <field name="name">student.class.form</field>
        <field name="model">student.class</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="capacity"/>
                    </group>

                    <notebook>
                        <page string="Students">
                            <field name="student_ids"/>
                        </page>

                        <page string="Subjects">
                            <field name="subject_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Subject List -->
    <record id="view_subject_list" model="ir.ui.view">
        <field name="name">student.subject.list</field>
        <field name="model">student.subject</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="teacher_id"/>
            </list>
        </field>
    </record>

    <!-- Subject Form -->
    <record id="view_subject_form" model="ir.ui.view">
        <field name="name">student.subject.form</field>
        <field name="model">student.subject</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="teacher_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_class" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">student.class</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_subject" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">student.subject</field>
        <field name="view_mode">list,form</field>
    </record>

   <!-- Academic Parent -->
<menuitem id="menu_academic_root"
          name="Academic"
          parent="student_menu_root"
          sequence="15"/>

<!-- Classes -->
<menuitem id="menu_class"
          name="Classes"
          parent="menu_academic_root"
          action="action_class"
          sequence="1"/>

<!-- Subjects -->
<menuitem id="menu_subject"
          name="Subjects"
          parent="menu_academic_root"
          action="action_subject"
          sequence="2"/>

</odoo>