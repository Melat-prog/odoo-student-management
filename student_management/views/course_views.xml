<odoo>
    <record id="view_course_list" model="ir.ui.view">
        <field name="name">student.course.list</field>
        <field name="model">student.course</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'open'" decoration-info="state == 'draft'" decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="grade" widget="badge" decoration-warning="1"/>
                <field name="duration"/>
                <field name="duration_unit"/>
                <field name="capacity"/>
                <field name="state" widget="badge" decoration-success="state == 'open'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_course_kanban" model="ir.ui.view">
        <field name="name">student.course.kanban</field>
        <field name="model">student.course</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="student_count"/>
                <field name="state"/>
                <field name="grade"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click shadow-sm">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="mt-2">
                                    <span class="badge rounded-pill text-bg-warning"><field name="grade"/></span>
                                </div>
                                <div class="text-muted mt-2">
                                    <i class="fa fa-users me-1"/> Students: <field name="student_count"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_course_form" model="ir.ui.view">
        <field name="name">student.course.form</field>
        <field name="model">student.course</field>
        <field name="arch" type="xml">
           <form>
               <header>
                    <button name="action_open_course" type="object" string="Open Course" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close_course" type="object" string="Close Course" invisible="state != 'open'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_students" class="oe_stat_button" icon="fa-users">
                            <field name="student_count" widget="statinfo" string="Students"/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Frontend Development"/></h1>
                    </div>

                    <group>
                        <group string="Configuration">
                            <field name="grade"/>
                            <field name="teacher_id"/>
                            <field name="capacity"/>
                        </group>
                        <group string="Timing &amp; Fees">
                            <label for="duration"/>
                            <div class="o_row">
                                <field name="duration"/>
                                <field name="duration_unit"/>
                            </div>
                            <field name="fees"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Lesson Plan" name="lessons" icon="fa-list-ol">
                            <field name="lesson_plan_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="content"/>
                                    <field name="duration_minutes"/>
                                </list>
                            </field>
                        </page>

                        <page string="Learning Resources" name="resources" icon="fa-book">
                            <field name="resource_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="resource_type"/>
                                    <field name="visibility"/>
                                </list>
                            </field>
                        </page>

                        <page string="Instructors" name="teachers" icon="fa-mortar-board">
                            <group>
                                <field name="teacher_id" string="Lead Instructor"/>
                                <field name="additional_teacher_ids" widget="many2many_tags"/>
                            </group>
                        </page>

                        <page string="Registered Students" name="students" icon="fa-graduation-cap">
                            <field name="student_ids" readonly="1">
                                <list>
                                    <field name="student_id"/>
                                    <field name="name"/>
                                    <field name="email"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_course" name="Courses" parent="student_menu_root" sequence="20"/>

    <record id="action_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">student.course</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="menu_course_action" parent="menu_course" action="action_course"/>
</odoo>